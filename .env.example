# API được gọi từ browser. Khi chạy local, Next.js rewrite /api/* sang backend :8080.
NEXT_PUBLIC_API_URL=/api/v1
# Tuỳ chọn: thêm hostname được phép mở `next dev` qua LAN (không có scheme/port).
# Khi đổi Wi-Fi/IP, cập nhật danh sách phân cách bằng dấu phẩy rồi khởi động lại frontend.
FAMS_DEV_ORIGINS=192.168.1.13

# Base URL server-side dùng cho rewrite và Route Handler. Không có dấu / cuối.
FAMS_BACKEND_URL=http://localhost:8080/api/v1

# Google OAuth public client ID (không đặt client secret trong NEXT_PUBLIC_*).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Custom scheme của Expo development build, dùng cho nút "Mở ứng dụng FAMS"
# sau khi xác thực email/đổi mật khẩu trên trình duyệt điện thoại.
NEXT_PUBLIC_MOBILE_APP_SCHEME=famsfrontappproject

# Firebase Web App config phục vụ xác thực số điện thoại.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Bản đồ. Production nên dùng tile/geocoding provider có SLA thay vì public demo endpoint.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
FAMS_GEOCODING_URL=https://nominatim.openstreetmap.org
FAMS_GEOCODING_USER_AGENT=FAMS-Web/0.1 (ops@example.com)
